rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidLeaderboardEntry(data) {
      return data.id is string && data.id.size() <= 128
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.score is number && data.score >= 0 && data.score <= 1000000
        && data.category is string && data.category.size() <= 50
        && data.ageGroup is string && data.ageGroup.size() <= 50;
    }

    match /leaderboard/{entryDocId} {
      allow read: if true;
      allow create, update: if isValidId(entryDocId) && isValidLeaderboardEntry(request.resource.data);
      allow delete: if true;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
